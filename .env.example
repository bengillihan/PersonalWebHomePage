# ---- Server ----
# Railway injects PORT. Locally the API listens on 3000 (Vite dev server proxies to it on 5173).
PORT=3000
# Public origin users visit. Used for OAuth redirect URI + cookie "Secure" flag. No trailing slash.
# Local dev with Vite: http://localhost:5173   |  Railway: https://<your-app>.up.railway.app
PUBLIC_BASE_URL=http://localhost:5173
# SQLite file. Default: /data/dashboard.sqlite on Railway (RAILWAY_ENVIRONMENT set), ./data/dashboard.sqlite locally.
# SQLITE_PATH=/data/dashboard.sqlite
# Long random string (>=32 chars): `openssl rand -base64 48`
SESSION_SECRET=

# ---- Google sign-in (OpenID Connect) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only this Google account may sign in.
ALLOWED_GOOGLE_EMAIL=

# ---- Gemini API (server-side only) ----
# Needs its own API key from https://aistudio.google.com/apikey; a consumer Gemini subscription does NOT include API usage.
GEMINI_API_KEY=
# Low-cost Flash-tier model. Verify current IDs at https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite
# Max Gemini requests per UTC day (0 = AI disabled). Can also be changed in Settings.
AI_DAILY_REQUEST_BUDGET=200

# ---- Market data (Twelve Data, https://twelvedata.com) ----
# Free "Basic" plan: 8 credits/min, 800/day, US equities + ETFs. Mutual fund NAV / some indexes need a paid plan.
MARKET_PROVIDER=twelvedata
TWELVEDATA_API_KEY=

# ---- Local-only development shortcut (ignored/refused when NODE_ENV=production) ----
# DEV_LOGIN=true  # lets you sign in as ALLOWED_GOOGLE_EMAIL at /auth/dev without Google credentials

# ---- Optional: external refresh trigger (leave empty to disable) ----
# If set (>=32 chars), POST /internal/refresh with "Authorization: Bearer <token>" starts a refresh. Use from a Railway cron service.
# CRON_TOKEN=
